<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Flow the `///` summaries into the OpenAPI document (host AND Core — the DTOs live in Core). -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="LupiraContactApi.UnitTests" />
  </ItemGroup>

  <ItemGroup>
    <!-- The bounded context + data: Domain (event-sourced aggregates + events + projections),
         Application (services + OpResult), Dtos, Mappers, Serialization (hand-rolled vCard 3.0),
         Auth/AccessResolver. Marten is the event store + document store on Postgres.
         No ASP.NET dependency — that lives in the host. -->
    <PackageReference Include="Lupira.Contracts.Dav" Version="1.0.0" />
    <PackageReference Include="Lupira.Contracts.PlaceRefs" Version="0.1.0" />
    <PackageReference Include="Lupira.Identity.Marten" Version="0.1.0" />
    <PackageReference Include="Lupira.Marten.Idempotency" Version="0.1.0" />
    <PackageReference Include="Lupira.Postgres.Health" Version="0.1.0" />
    <PackageReference Include="Lupira.Primitives" Version="1.0.0" />
    <PackageReference Include="Lupira.Results" Version="1.0.0" />
    <PackageReference Include="Lupira.Sync" Version="0.1.0" />
    <PackageReference Include="Marten" Version="9.40.0" />
  </ItemGroup>

</Project>
