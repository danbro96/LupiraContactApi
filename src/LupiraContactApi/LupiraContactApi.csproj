<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Flow the `///` summaries into the OpenAPI document (host AND Core — the DTOs live in Core). -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <!-- Build-time OpenAPI document (openapi/LupiraContactApi.json). Doc-gen boots the app; generation
       runs on local builds only and is skipped in CI (no dev Postgres there). -->
  <PropertyGroup>
    <OpenApiDocumentsDirectory>$(MSBuildThisFileDirectory)..\..\openapi</OpenApiDocumentsDirectory>
    <OpenApiGenerateDocuments>true</OpenApiGenerateDocuments>
    <OpenApiGenerateDocumentsOnBuild>true</OpenApiGenerateDocumentsOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="LupiraContactApi.IntegrationTests" />
  </ItemGroup>

  <ItemGroup>
    <!-- The bounded context (Domain + Application + Data). The host is a thin transport/composition
         layer over it; the project boundary keeps ASP.NET out of the core. -->
    <ProjectReference Include="..\LupiraContactApi.Core\LupiraContactApi.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.9" />
    <PackageReference Include="Microsoft.Extensions.ApiDescription.Server" Version="10.0.9">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.OpenApi" Version="2.7.5" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.9" />
    <PackageReference Include="Lupira.Auth.DevUser" Version="0.1.0" />
    <PackageReference Include="Lupira.Hosting.Defaults" Version="0.1.0" />
    <PackageReference Include="Lupira.Hosting.Health" Version="0.1.0" />
    <PackageReference Include="Lupira.Hosting.LanEdge" Version="1.0.0" />
    <PackageReference Include="Lupira.Hosting.Observability" Version="0.1.1" />
    <PackageReference Include="Lupira.Hosting.Problems" Version="0.1.0" />
    <PackageReference Include="Lupira.Mcp" Version="0.1.0" />
    <PackageReference Include="Scalar.AspNetCore" Version="2.16.5" />
  </ItemGroup>

</Project>
